script.on_event(defines.events.on_built_entity, function(event)
    local entity = event.entity
    if not entity.valid then return end

    if entity.name == "lava-heating-tower" then
        if storage.vulcanus_lava_power[entity.unit_number] == nil then
            storage.vulcanus_lava_power = {}
        end


        local assembler = entity.surface.create_entity {
            name = "assembling-machine-3",
            position = entity.position,
            force = entity.force_index,
            direction = entity.direction,
            quality = entity.quality,
            create_build_effect_smoke = false,
            fixed_recipe = "lava-fuel"
        }
        assembler.destructible = false
        assembler.operable = false
        assembler.minable_flag = false
        assembler.fluidbox.add_linked_connection(0, entity, 0)
        assembler.fluidbox.add_linked_connection(0, entity, 1)
        assembler.fluidbox.add_linked_connection(0, entity, 2)
        assembler.fluidbox.add_linked_connection(0, entity, 3)
        assembler.fluidbox.add_linked_connection(0, entity, 4)
        assembler.fluidbox.add_linked_connection(0, entity, 5)
        assembler.fluidbox.add_linked_connection(0, entity, 6)
        assembler.fluidbox.add_linked_connection(0, entity, 7)
        storage.vulcanus_lava_power[entity.unit_number] = assembler
    end
end)

script.on_event(defines.events.on_object_destroyed, function(event)
    local entity = event.entity
    if not entity.valid then return end

    if entity.name == "lava-heating-tower" then
        local assembler = storage.vulcanus_lava_power[entity.unit_number]
        if assembler then assembler.destroy() end
    end
end)
